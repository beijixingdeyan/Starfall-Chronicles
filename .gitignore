# =============================================================
# Starfall Chronicles — .gitignore
# 本仓库将公开上传至 GitHub：任何隐私/机器相关文件一律不入库。
# =============================================================

# ---- 任务要求文件（不入库） ----
mc_modpack_civilization_prompt.txt
*_prompt.txt

# ---- 运行时/启动器生成物 ----
pack/.minecraft/mods/
pack/.minecraft/saves/
pack/.minecraft/logs/
pack/.minecraft/crash-reports/
pack/.minecraft/options.txt
pack/.minecraft/options*.txt
pack/.minecraft/servers.dat
pack/.minecraft/usercache.json
pack/.minecraft/usernamecache.json
pack/.minecraft/shaderpacks/
pack/.minecraft/resourcepacks/*.zip
pack/.minecraft/libraries/
pack/.minecraft/versions/
!pack/.minecraft/datapacks/
!pack/.minecraft/resourcepacks/starciv_resources/

# ---- 下载与临时产物 ----
downloads/
*.jar
*.zip
*.tmp
*.log

# ---- 构建/打包产物 ----
dist/
build_pcl/
*.mrpack
*.zip

# ---- 专用服务器生成物（脚本自动生成，不入库）----
server/libraries/
server/mods/
server/world/
server/logs/
server/crash-reports/
server/config/
server/kubejs/
server/local/
server/rhino.local.properties
server/user_jvm_args.txt
server/eula.txt
server/server.properties
server/run.bat
server/run.sh
server/forge-*.jar
server/installer-*.jar
server/usercache.json
server/banned-ips.json
server/banned-players.json
server/ops.json
server/whitelist.json
server/backups/
server/modernfix/
server/moonlight-global-datapacks/
server/patchouli_books/
server/defaultconfigs/
server/scripts/

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml