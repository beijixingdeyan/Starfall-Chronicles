		{
			id: "3A0E9B4A6F3EAF91"
			title: "图鉴 · 荒野巨兽"
			subtitle: ""
			description: "【Alex 的猛兽（Alex 的动物）】荒野生物图鉴（部分）：\n  · 驼鹿 Moose：针叶林，掉落鹿皮，可做装备\n  · 箭猪 Porcupine：森林，被攻击会反击\n  · 秃鹫 Vulture：荒野，食腐，会聚集在尸体旁\n  · 鳄鱼 Crocodile：沼泽/河流，水里很快\n  · 金丝雀 Canary：矿洞，报警提示危险\n【任务】收集 4 张【皮革】合成皮革套装，象征你开始在这片土地立足。\n【提示】远距离用弓箭，近战看走位；大型掠食者前期避开。"
		dependencies: ["161683BD7C1C456D"]
			x: 6.0d
			y: 0.0d
			icon: { Count: 1, id: "minecraft:leather", tag: { } }
			tasks: [
				{ id: "7075324A28CECE30", type: "item", item: { Count: 1, id: "minecraft:leather", tag: { } }, count: 4L }
			]
			rewards: [
			]
		}
		{
			id: "4BF8F83DBFF58890"
			title: "图鉴 · 友邻生灵"
			subtitle: ""
			description: "【自然友好生物】它们不攻击你，且各有用途：\n  · 火蜥蜴（Naturalist）：温暖水域，可驯养为伙伴\n  · 蝴蝶/小鹿（Naturalist）：点缀生态\n  · 萤火虫（自然生成）：夜晚的微光\n  · 兔/羊驼/狐狸：常规友好生物，可繁殖\n【任务】用胡萝卜繁殖 2 只兔子（或任意友好生物）。\n【提示】友好生物是生态链的信号：它们在，说明这片土地还健康。"
		dependencies: ["3A0E9B4A6F3EAF91"]
			x: 8.0d
			y: 0.0d
			icon: { Count: 1, id: "minecraft:carrot", tag: { } }
