				{ id: "B884F7233EEFCB71", type: "advancement", advancement: "starciv:agriculture/stellar_key" }
			]
			rewards: [
			]
		}
		{
			id: "DA7BA5DACC19A825"
			title: "③ 铁锈 · 踏上废土"
			subtitle: ""
			description: "主线第三步（需持有星门钥匙）。\n【去哪里】回到绿谷星门（独石碑旁的发光方框），手持【星门钥匙】走进去，传送到铁锈星。\n【铁锈星是什么】旧文明的工业心脏：锈红色的天与地、废弃工厂、高炉群、深埋的紫水晶矿。\n【干什么】落地后探索废墟，收集初期物资，为重启抛光线做准备。\n【注意】铁锈星昼夜温差大，带足食物；夜里警惕游荡的亡灵。"
		dependencies: ["842B847A4A16859F"]
			x: 4.0d
			y: 0.0d
			icon: { Count: 1, id: "minecraft:iron_ingot", tag: { } }
			tasks: [
				{ id: "1E1AC314512993DE", type: "dimension", dimension: "starciv:rustfall" }
				{ id: "AAB933A8CA1902DF", type: "advancement", advancement: "starciv:industry/arrival" }
			]
			rewards: [
			]
		}
		{
			id: "6DB4D833EF7DC88B"
			title: "④ 铁锈 · 生物燃料"
			subtitle: ""
			description: "主线第四步。\n【材料】上古之种（或它的胚体）+ 木炭（烧原木）。\n【怎么做】按 JEI 配方合成【生物燃料罐】。\n【为什么】生物燃料是重启铁锈星机器的燃料——它们让锈蚀的传动轴重新转动，也解锁后续工厂科技。\n【提示】这步是农业与工业的第一次握手，之后绿谷粮食→铁锈燃料的循环就建立了。"
		dependencies: ["DA7BA5DACC19A825"]
			x: 6.0d
			y: 0.0d
			icon: { Count: 1, id: "starciv:biofuel_canister", tag: { } }
			tasks: [
				{ id: "C2F6C936117489C3", type: "item", item: { Count: 1, id: "starciv:biofuel_canister", tag: { } }, count: 1L }
				{ id: "3C232021959AE413", type: "advancement", advancement: "starciv:industry/fuel" }
			]
			rewards: [
			]
		}
		{
			id: "61E13D05649DECE9"
			title: "⑤ 铁锈 · 数据裂片"
			subtitle: ""
			description: "主线第五步。\n【去哪里】铁锈星地下：紫水晶矿石在矿洞深处与遗迹中常见。\n【干什么】开采紫水晶，用研磨装置或精准采集加工成【数据裂片】，集齐 8 片。\n【为什么】裂片记录了旧文明的生产参数，是后续精密零件的图纸来源。\n【提示】挖矿带好火把与镐；深矿层注意岩浆与怪物。"
		dependencies: ["6DB4D833EF7DC88B"]
			x: 8.0d
