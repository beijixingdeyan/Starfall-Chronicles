		{
			id: "8B92E19FC7C969A6"
			title: "地标 · 晨曦花园城堡"
			subtitle: ""
			description: "【地标档案：晨曦花园城堡】\n【位置】绿谷星 (60, 79, -250)\n【外观】石砖与玻璃构成的童话花园城堡：主塔、花园庭院、环形护城河。\n【看点】主塔观景台看日出；花园里四季花卉（季节系统）轮换开放；夜晚城堡灯火通明——是绿谷的地标名片。\n【拍照点】护城河对岸正南方向，能拍到整座城堡倒影。\n【任务】抵达城堡并完成主线④的燃料任务后，这里就是你的后勤基地。"
		dependencies: ["344E817FC0ADE061"]
			x: 6.0d
			y: 0.0d
			icon: { Count: 1, id: "minecraft:stone_brick_stairs", tag: { } }
			tasks: [
				{ id: "3B3B301E543EBD8D", type: "item", item: { Count: 1, id: "minecraft:stone_bricks", tag: { } }, count: 16L }
			]
			rewards: [
			]
		}
		{
			id: "D64293F13A66E9FD"
			title: "地标 · 铁锈灯塔"
			subtitle: ""
			description: "【地标档案：铁锈灯塔】\n【位置】铁锈星 (480, 76, 460)\n【外观】锈色废土上直插天穹的灯塔：红砖塔身、顶部灯室、螺旋外梯。\n【看点】灯室在夜里发出醒目光束；塔顶平台可以远眺高炉群与推进器残骸；废土日落时灯影拉得很长，是铁锈星最出名的摄影点。\n【任务】亲自登塔（任务：建筑线之二已完成者直接解锁）。"
		dependencies: ["8B92E19FC7C969A6"]
			x: 8.0d
			y: 0.0d
