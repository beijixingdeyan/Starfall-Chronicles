				{ id: "F628E8CE069F7CAD", type: "item", item: { Count: 1, id: "pipez:item_pipe", tag: { } }, count: 1L }
			]
			rewards: [
			]
		}
		{
			id: "B0527B0BD38DDD1A"
			title: "百科 · Create 入门"
			subtitle: ""
			description: "【创造（Create）】本包的中期机械核心。\n【是什么】用传动轴+齿轮+皮带搭出“齿轮机械城市”：\n  · 动力源：水车、风车、蒸汽机\n  · 传动：传动轴（铁）、齿轮箱（变速）\n  · 工作机：鼓风机、碾磨机、钻头、机械臂、传送带\n【怎么上手】先做 1 个【齿轮】（create:cogwheel），再连一根轴带动它；看着它转起来，你就入门了。\n【推荐】机械动力官方演示（游戏内/网上均有）。\n【本包配套】工业熔炉、动能网络、物流管道都是它的应用。"
		dependencies: ["81E1A9D294CA030E"]
			x: 8.0d
			y: 0.0d
			icon: { Count: 1, id: "create:cogwheel", tag: { } }
			tasks: [
				{ id: "3DC1D425D5ECF9B0", type: "item", item: { Count: 1, id: "create:cogwheel", tag: { } }, count: 1L }
			]
			rewards: [
			]
		}
		{
			id: "7E0B609BC207A1B5"
			title: "百科 · 沉浸工程"
			subtitle: ""
			description: "【沉浸工程（Immersive Engineering）】高压电网与重工。\n【是什么】多块结构（Multi-block）的工业模组：高炉、电弧炉、高压线塔、炼油厂。\n【怎么上手】\n  · 造【工程师锤】锻打多块结构\n  · 搭高压电网：发电机→变压器→线塔→机器\n  · 电弧炉一次熔炼 3 矿物\n【本包定位】铁锈星的电网基建，与 Create 并行不悖：传动管机械，电网管冶金。\n【提示】高压线有电，别裸手碰（会掉血）。"
		dependencies: ["B0527B0BD38DDD1A"]
