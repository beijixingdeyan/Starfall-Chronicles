				{ id: "E3E01894CC7505F0", type: "item", item: { Count: 1, id: "minecraft:coal", tag: { } }, count: 16L }
			]
			rewards: [
			]
		}
		{
			id: "F32CCFCFA69D8F6C"
			title: "动能网络（Create 骨架）"
			subtitle: ""
			description: "科技线之三：铺设传动。\n【材料】8 根【传动轴】（Create：木轴+铁片，JEI 查看）+ 1 个拉杆。\n【干什么】把传动轴连接动力源（水车/风车/手摇机），让动力传到机器。\n【为什么】动能网络是 Create 自动化一切的骨架——传送带、钻头、机械臂都靠它。\n【提示】对着传动轴右键可以调整朝向，Shift+右键拆除。"
		dependencies: ["792DC7E00D3F297E"]
			x: 4.0d
			y: 0.0d
			icon: { Count: 1, id: "create:shaft", tag: { } }
			tasks: [
				{ id: "46AB794D923BB5C5", type: "item", item: { Count: 1, id: "create:shaft", tag: { } }, count: 8L }
				{ id: "BEDBF59B903B8F4A", type: "item", item: { Count: 1, id: "minecraft:lever", tag: { } }, count: 1L }
			]
			rewards: [
			]
		}
		{
			id: "81E1A9D294CA030E"
			title: "物流管道（自动转运）"
			subtitle: ""
			description: "科技线之四：让物资自己流动。\n【材料】1 个【物品管道】（Pipez，JEI 查看配方）。\n【干什么】把仓库与机器用管道连起来（管道可左键切换提取/输入模式）。\n【为什么】物流网络建成后，铁锈-绿谷的物资不再需要人肉搬运。\n【提示】Pipez 管道支持升级件，后期可提速至无限。"
		dependencies: ["F32CCFCFA69D8F6C"]
			x: 6.0d
			y: 0.0d
			icon: { Count: 1, id: "pipez:item_pipe", tag: { } }
