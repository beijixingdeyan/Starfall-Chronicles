		{
			id: "8F2AECF4392162C9"
			title: "手作工坊（自动化入门）"
			subtitle: ""
			description: "科技线之一：建立你的第一座车间。\n【材料】2 个活塞（木板+圆石+铁锭+红石）+ 8 个铁锭。\n【干什么】造出活塞后，用 Create 的【传动轴】（见科技线 x_tech_create）把第一台机器转起来。\n【指引】这条线最终通向硅火的精密制造；主线⑤⑥⑦会用到这里的知识。\n【背景】技师手册第一课：工具先于文明。"
		dependencies: [ ]
			x: 0.0d
			y: 0.0d
			icon: { Count: 1, id: "minecraft:piston", tag: { } }
			tasks: [
				{ id: "ABFF93B51726275A", type: "item", item: { Count: 1, id: "minecraft:piston", tag: { } }, count: 2L }
				{ id: "1F389E7BFB72570A", type: "item", item: { Count: 1, id: "minecraft:iron_ingot", tag: { } }, count: 8L }
			]
			rewards: [
			]
		}
		{
			id: "792DC7E00D3F297E"
			title: "工业熔炉（规模冶炼）"
			subtitle: ""
			description: "科技线之二：铸造高炉。\n【材料】高炉（5 铁锭 + 熔炉 + 3 平滑石）+ 16 块煤。\n【为什么】高炉是铁锈星工业的心脏：冶炼速度翻倍，是生产精密零件的必须配套。\n【指引】建议在抵达铁锈星后完成；随后去【维度】页签认识铁锈星全貌。\n【背景】重工业可以粗粝，但必须可控。"
		dependencies: ["8F2AECF4392162C9"]
			x: 2.0d
			y: 0.0d
			icon: { Count: 1, id: "minecraft:blast_furnace", tag: { } }
